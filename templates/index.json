    "custom_liquid_7akFbT": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "custom_liquid": "<style>\n  .kb-guide {\n    direction: rtl;\n    text-align: right;\n    font-family: inherit;\n    color: #272727;\n    background: #ffffff;\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 50px 20px;\n    line-height: 1.9;\n  }\n\n  .kb-guide * {\n    box-sizing: border-box;\n  }\n\n  .kb-hero {\n    text-align: center;\n    background: linear-gradient(135deg, #fff5f7 0%, #f7f3ee 100%);\n    border-radius: 24px;\n    padding: 55px 25px;\n    margin-bottom: 35px;\n  }\n\n  .kb-badge {\n    display: inline-block;\n    background: #ffffff;\n    border: 1px solid #eadadd;\n    border-radius: 50px;\n    padding: 7px 18px;\n    margin-bottom: 15px;\n    font-size: 14px;\n    font-weight: 600;\n  }\n\n  .kb-hero h1 {\n    font-size: 38px;\n    line-height: 1.35;\n    margin: 0 0 15px;\n    color: #1f1f1f;\n  }\n\n  .kb-hero p {\n    max-width: 720px;\n    margin: 0 auto;\n    font-size: 18px;\n    color: #555;\n  }\n\n  .kb-intro {\n    font-size: 17px;\n    margin-bottom: 30px;\n  }\n\n  .kb-section {\n    margin-bottom: 18px;\n    border: 1px solid #eeeeee;\n    border-radius: 18px;\n    overflow: hidden;\n    background: #ffffff;\n  }\n\n  .kb-section summary {\n    list-style: none;\n    cursor: pointer;\n    padding: 22px 25px;\n    font-size: 20px;\n    font-weight: 700;\n    color: #222;\n    position: relative;\n    background: #fcfcfc;\n  }\n\n  .kb-section summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .kb-section summary::after {\n    content: \"+\";\n    position: absolute;\n    left: 24px;\n    top: 50%;\n    transform: translateY(-50%);\n    font-size: 27px;\n    font-weight: 400;\n  }\n\n  .kb-section[open] summary::after {\n    content: \"−\";\n  }\n\n  .kb-content {\n    padding: 0 25px 25px;\n    font-size: 16px;\n    color: #444;\n  }\n\n  .kb-content p {\n    margin: 0 0 15px;\n  }\n\n  .kb-list {\n    margin: 10px 0 20px;\n    padding: 0 22px 0 0;\n  }\n\n  .kb-list li {\n    margin-bottom: 7px;\n  }\n\n  .kb-steps {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 12px;\n    margin: 22px 0;\n  }\n\n  .kb-step {\n    text-align: center;\n    border: 1px solid #eee;\n    border-radius: 15px;\n    padding: 20px 10px;\n    background: #fafafa;\n  }\n\n  .kb-step-number {\n    width: 35px;\n    height: 35px;\n    margin: 0 auto 10px;\n    border-radius: 50%;\n    background: #f3dfe3;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 700;\n  }\n\n  .kb-products {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 15px;\n    margin-top: 20px;\n  }\n\n  .kb-product {\n    padding: 20px;\n    background: #fafafa;\n    border: 1px solid #eeeeee;\n    border-radius: 16px;\n  }\n\n  .kb-product h3 {\n    font-size: 17px;\n    margin: 0 0 8px;\n    color: #222;\n  }\n\n  .kb-product p {\n    margin: 0;\n    font-size: 15px;\n  }\n\n  .kb-trust {\n    margin-top: 40px;\n    padding: 35px 25px;\n    background: #272727;\n    color: #ffffff;\n    border-radius: 22px;\n  }\n\n  .kb-trust h2 {\n    color: #ffffff;\n    font-size: 27px;\n    margin: 0 0 15px;\n  }\n\n  .kb-trust p {\n    color: #efefef;\n  }\n\n  .kb-trust-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 12px;\n    margin-top: 25px;\n  }\n\n  .kb-trust-item {\n    border: 1px solid rgba(255,255,255,.16);\n    border-radius: 14px;\n    padding: 18px 10px;\n    text-align: center;\n    font-size: 14px;\n  }\n\n  .kb-final {\n    margin-top: 30px;\n    text-align: center;\n    font-size: 23px;\n    font-weight: 700;\n  }\n\n  .kb-button-wrap {\n    text-align: center;\n    margin-top: 25px;\n  }\n\n  .kb-button {\n    display: inline-block;\n    background: #222222;\n    color: #ffffff !important;\n    text-decoration: none;\n    border-radius: 50px;\n    padding: 14px 32px;\n    font-weight: 700;\n    transition: opacity .2s ease;\n  }\n\n  .kb-button:hover {\n    opacity: .8;\n  }\n\n  @media screen and (max-width: 749px) {\n    .kb-guide {\n      padding: 25px 14px;\n    }\n\n    .kb-hero {\n      padding: 38px 18px;\n      border-radius: 18px;\n    }\n\n    .kb-hero h1 {\n      font-size: 28px;\n    }\n\n    .kb-hero p {\n      font-size: 16px;\n    }\n\n    .kb-section summary {\n      padding: 19px 18px 19px 50px;\n      font-size: 18px;\n    }\n\n    .kb-section summary::after {\n      left: 18px;\n    }\n\n    .kb-content {\n      padding: 0 18px 20px;\n    }\n\n    .kb-steps,\n    .kb-products,\n    .kb-trust-grid {\n      grid-template-columns: 1fr 1fr;\n    }\n\n    .kb-final {\n      font-size: 20px;\n    }\n  }\n\n  @media screen and (max-width: 430px) {\n    .kb-steps,\n    .kb-products,\n    .kb-trust-grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n\n<section class=\"kb-guide\">\n\n  <div class=\"kb-hero\">\n    <span class=\"kb-badge\">دليلك الموثوق للعناية الكورية</span>\n    <h1>إيه هو الـ K-Beauty؟</h1>\n    <p>\n      كل اللي محتاجة تعرفيه عن العناية الكورية، اختيار المنتجات الصح\n      وبناء روتين يناسب بشرتك بدون تعقيد أو وعود مبالغ فيها.\n    </p>\n  </div>\n\n  <div class=\"kb-intro\">\n    <p>\n      الـ <strong>K-Beauty</strong> هو اختصار لـ Korean Beauty، لكنه مش مجرد\n      منتجات كورية أو روتين من عشر خطوات.\n    </p>\n\n    <p>\n      فلسفة العناية الكورية قائمة على مبدأ بسيط:\n      <strong>نهتم بصحة البشرة الأول، بدل ما نحاول نخفي مشاكلها مؤقتًا.</strong>\n    </p>\n\n    <p>\n      علشان كده أغلب المنتجات الكورية بتركز على الترطيب، تهدئة البشرة،\n      تقوية حاجزها وحمايتها على المدى الطويل، باستخدام تركيبات فعالة\n      ومريحة للاستخدام اليومي.\n    </p>\n  </div>\n\n  <details class=\"kb-section\" open>\n    <summary>إيه اللي بيميز المنتجات الكورية؟</summary>\n\n    <div class=\"kb-content\">\n      <p>\n        المنتجات الكورية معروفة بتركيباتها المتطورة، وقوامها الخفيف\n        واهتمامها بالتوازن بين الفعالية وراحة البشرة.\n      </p>\n\n      <p>ومن أشهر المكونات المستخدمة:</p>\n\n      <ul class=\"kb-list\">\n        <li>السنتيلا لتهدئة البشرة.</li>\n        <li>الجينسينج لدعم النضارة ومظهر البشرة.</li>\n        <li>النياسيناميد لتوحيد مظهر اللون وتنظيم الدهون.</li>\n        <li>السيراميد لدعم حاجز البشرة.</li>\n        <li>الـ Heartleaf للبشرة الحساسة والمعرضة للاحمرار.</li>\n        <li>المكونات المخمّرة لدعم الترطيب وامتصاص المنتجات.</li>\n      </ul>\n    </div>\n  </details>\n\n  <details class=\"kb-section\">\n    <summary>هل الـ K-Beauty فعلًا يستاهل كل الضجة؟</summary>\n\n    <div class=\"kb-content\">\n      <p>\n        أيوه، لكن النتيجة مش بسبب إن المنتج كوري وخلاص.\n      </p>\n\n      <p>سر نجاح الـ K-Beauty هو الجمع بين:</p>\n\n      <ul class=\"kb-list\">\n        <li>تركيبات متطورة.</li>\n        <li>مكونات فعالة.</li>\n        <li>قوام خفيف ومريح.</li>\n        <li>اهتمام بصحة حاجز البشرة.</li>\n        <li>تنوع كبير يناسب أنواع واحتياجات مختلفة.</li>\n      </ul>\n\n      <p>\n        لكن مهم نكون واقعيين:\n        <strong>مفيش منتج واحد مناسب لكل الناس، ومفيش نتيجة سحرية من أول استخدام.</strong>\n        النتيجة الحقيقية بتيجي من اختيار المنتج المناسب، استخدامه بطريقة صحيحة\n        والاستمرار عليه.\n      </p>\n    </div>\n  </details>\n\n  <details class=\"kb-section\">\n    <summary>هل لازم أعمل روتين من 10 خطوات؟</summary>\n\n    <div class=\"kb-content\">\n      <p>\n        لا طبعًا. الروتين الناجح مش بعدد المنتجات، لكنه باحتياج بشرتك.\n        تقدري تبدأي بأربع خطوات أساسية:\n      </p>\n\n      <div class=\"kb-steps\">\n        <div class=\"kb-step\">\n          <div class=\"kb-step-number\">1</div>\n          <strong>غسول</strong>\n          <div>مناسب لنوع بشرتك</div>\n        </div>\n\n        <div class=\"kb-step\">\n          <div class=\"kb-step-number\">2</div>\n          <strong>علاج</strong>\n          <div>يستهدف المشكلة الأساسية</div>\n        </div>\n\n        <div class=\"kb-step\">\n          <div class=\"kb-step-number\">3</div>\n          <strong>مرطب</strong>\n          <div>يدعم حاجز البشرة</div>\n        </div>\n\n        <div class=\"kb-step\">\n          <div class=\"kb-step-number\">4</div>\n          <strong>واقي شمس</strong>\n          <div>كل صباح</div>\n        </div>\n      </div>\n\n      <p>\n        وفي المساء، ممكن تعملي تنظيف مزدوج لو بتستخدمي مكياج أو واقي شمس\n        مقاوم للمياه. وبعد ما بشرتك تتأقلم مع الأساسيات، أضيفي أي منتج جديد\n        بالتدريج، منتج واحد في كل مرة.\n      </p>\n    </div>\n  </details>\n\n  <details class=\"kb-section\">\n    <summary>أختار المنتج المناسب إزاي؟</summary>\n\n    <div class=\"kb-content\">\n      <p>\n        مش كل منتج ترند هيكون مناسب لبشرتك. قبل اختيار أي منتج، لازم نعرف:\n      </p>\n\n      <ul class=\"kb-list\">\n        <li>نوع البشرة.</li>\n        <li>المشكلة الأساسية اللي عايزين نستهدفها.</li>\n        <li>المنتجات المستخدمة حاليًا.</li>\n        <li>مدى تحمّل البشرة للمكونات الفعالة.</li>\n        <li>هل حاجز البشرة صحي ولا محتاج تهدئة الأول.</li>\n      </ul>\n\n      <p>\n        البشرة الحساسة مثلًا ممكن تحتاج تهدئة وتقوية للحاجز قبل استخدام\n        الريتينول أو الأحماض. والبشرة المعرضة للحبوب مش شرط تحتاج منتجات\n        قوية أو مجففة.\n      </p>\n\n      <p>\n        علشان كده في <strong>Korean Beautys</strong> هدفنا مش إننا نبيع لكِ\n        أكبر عدد من المنتجات، لكن نساعدك تختاري روتين فعليًا مناسب لبشرتك.\n      </p>\n    </div>\n  </details>\n\n  <details class=\"kb-section\">\n    <summary>إزاي أتأكد إن المنتج الكوري أصلي؟</summary>\n\n    <div class=\"kb-content\">\n      <p>\n        مع انتشار المنتجات الكورية، زادت المنتجات المقلدة والمنتجات مجهولة\n        المصدر. علشان كده السعر لوحده مش كفاية للحكم على المنتج.\n      </p>\n\n      <p>\n        اختاري متجر موثوق يهتم بمصدر المنتجات، التخزين الصحيح، حالة العبوة\n        وتواريخ الصلاحية.\n      </p>\n\n      <p>\n        في <strong>Korean Beautys</strong> بنوفر منتجات كورية أصلية من مصادر\n        موثوقة، وبنراجع المنتجات قبل عرضها علشان توصلك بحالتها الصحيحة.\n      </p>\n    </div>\n  </details>\n\n  <div class=\"kb-trust\">\n    <h2>ليه تختاري Korean Beautys؟</h2>\n\n    <p>\n      لأننا مش مجرد متجر بيبيع المنتجات الأكثر انتشارًا. بنساعدك تفهمي\n      احتياج بشرتك وتختاري المنتجات المناسبة، بمعلومات واضحة وبدون وعود\n      مبالغ فيها.\n    </p>\n\n    <div class=\"kb-trust-grid\">\n      <div class=\"kb-trust-item\">منتجات كورية أصلية</div>\n      <div class=\"kb-trust-item\">مصادر موثوقة</div>\n      <div class=\"kb-trust-item\">فريق متخصص للمساعدة</div>\n      <div class=\"kb-trust-item\">دعم قبل وبعد الطلب</div>\n    </div>\n  </div>\n\n  <div class=\"kb-final\">\n    بشرتك مش محتاجة منتجات أكتر… محتاجة اختيارات أذكى.\n  </div>\n\n  <div class=\"kb-button-wrap\">\n    <!-- غيّر /collections/all إلى رابط الكولكشن المطلوب -->\n    <a href=\"https://www.koreanbeautys.com/collections/in-stock\" class=\"kb-button\">\n      اكتشفي منتجات الـ K-Beauty\n    </a>\n  </div>\n\n</section>",
