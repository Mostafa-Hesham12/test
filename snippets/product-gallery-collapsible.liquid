{%- liquid
  assign heading_size = block.settings.heading_size | default: 'h4'
  assign gallery = product.metafields.custom.gallery.value
-%}

{%- if gallery != blank -%}
  <details
    id="Details-{{ block.id }}-{{ section_id }}"
    class="accordion-details"
    is="accordion-group"
    {% if block.settings.default_open %}
      open
      aria-expanded="true"
    {% else %}
      aria-expanded="false"
    {% endif %}
  >
    <summary class="accordion-details__summary flex items-center justify-between">
      <div class="flex items-center gap-2">
        <h2 class="{{ heading_size }} inline-richtext">
          {{ block.settings.heading | default: 'Gallery' | escape }}
        </h2>
      </div>

      {%- render 'icon-plus-toggle' -%}
    </summary>

    <div class="accordion-details__content">
      <div class="product-metafield-gallery">
        {%- for image in gallery -%}
          {{
            image
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              widths: '480, 750, 1000, 1500, 2000',
              class: 'product-metafield-gallery__image'
          }}
        {%- endfor -%}
      </div>
    </div>
  </details>
{%- endif -%}